# DB CONFIGURATION
 # Diagnocare Service
DB_USERNAME=postgres
DB_PASSWORD=<your_db_password>
DB_NAME=diagnocaredb
DIAGNOCARE_DB_PORT=5433
 # Auth Service
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=<your_auth_db_password>
AUTH_DB_NAME=auth_db
AUTH_DIAGNOCARE_DB_PORT=5432

# MONGODB CONFIGURATION
MONGODB_URI=<your_mongodb_connection_string>
MONGODB_DB_NAME=mongo_demo_db

# AUTHENTICATION SECRET KEYS
SECRET_KEY=<your_secret_key>
REFRESH_SECRET_KEY=<your_refresh_secret_key>
TOKEN_EXPIRATION_TIME=3600000
REFRESH_TOKEN_EXPIRATION_TIME=86400000

# GMAIL CREDENTIAL
SMTP_USERNAME=<your_smtp_email>
SMTP_PASSWORD=<your_smtp_password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# For DagnocareService
CHECKIN_BASE_URL=http://localhost:3000/check-in
CHECKIN_SCHEDULER_DELAY_MS=900000   # 15 minutes
CHECKIN_FIRST_REMINDER_MINUTES=1440 # 24 hours
CHECKIN_SECOND_REMINDER_MINUTES=2880 # 48 hours

# Encryption secret key
ENCRYPTION_SECRET_KEY="<your_encryption_secret_key>"
